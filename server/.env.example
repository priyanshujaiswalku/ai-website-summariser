# Server port
PORT=5000

# Groq API key (free tier available at https://console.groq.com/keys)
# The app is written against Groq's OpenAI-compatible /chat/completions endpoint,
# but you can swap in OpenAI or Gemini by changing AI_PROVIDER + the request
# shape in services/summarize.js
GROQ_API_KEY=your_groq_api_key_here

# Which AI model to use (Groq-hosted Llama 3.3 is fast and free)
GROQ_MODEL=llama-3.3-70b-versatile

